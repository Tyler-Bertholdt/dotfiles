{
        "modules-left": [
                "group/terminal"
        ],


        "group/terminal": {
                "orientation": "horizontal",
                "drawer": {
                        "transition-duration": 500,
                        "children-class": "button1",
                        "transition-left-to-right": true,
                        "click-to-reveal": true
                },
                "modules": [
                        "custom/tyler",
                        "custom/window_title",
                        "custom/file",
                        "custom/edit",
                        "custom/view",
                        "custom/window",
                        "custom/go",
                        "custom/help"

                ]
        },
        "custom/tyler":{
                "format":"󰣇",
                "tooltip":false
        },
"custom/window_title": {
    "exec": "/home/tyler/dotfiles/scripts/window_title.sh",
    "interval": 1,
    "format": "{}",
    "on-click":"none"
},

        "custom/file":{
                "format":"File",
                "tooltip":false,
                "on-click":"thunar"
        },
        "custom/edit":{
                "format":"Edit",
                "tooltip":false,
                "on-click":"/home/tyler/dotfiles/scripts/nvimdotfiles.sh"
        },
        "custom/view":{
                "format":"View",
                "tooltip":false,
                "on-click":"~/.config/scripts/killwaybar.sh & ~/.config/scripts/dockreload.sh & notify-send -t 2500 'Pressed View' 'Press Alt + D to Show again'"
        },
 
        "custom/window":{
                "format":"Window",
                "tooltip":false,
                "on-click": "~/dotfiles/scripts/window_switcher.sh"

        },
        "custom/go":{
                "format":"Go",
                "tooltip":false

        },
        "custom/help":{
                "format":"Help",
                "tooltip":false
        }


}
