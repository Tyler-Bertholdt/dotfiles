// -*- mode: jsonc -*-
{
   /* 
   !!!!!!!!!!!!!!!!!!!!
   !! Waybar_Configs !!
   !!!!!!!!!!!!!!!!!!!!
   */  
   "layer": "bottom",
   "position": "top",
   "spacing": 0,
   "height": 10,
   "margin-top": 3,
   "margin-right": 2,
   "margin-left": 3,
   "padding-right":5,
   "padding-left":5,

   /*
   !!!!!!!!!!!!!!!
   !!! Modules !!!
   !!!!!!!!!!!!!!!
   */

   "modules-left": [
           "group/terminal" 
   ],
   "modules-center": [
           "hyprland/workspaces",
           "hyprland/window"
   ],
   "modules-right": [
           "pulseaudio","battery",
           "tray" ,  "custom/swaync" , "clock"
   ],

  /*
    !!!!!!!!!!!!!!!!!!!!!!!
    !!! Modules Configs !!!
    !!!!!!!!!!!!!!!!!!!!!!!
  */
  "group/terminal": {
          "orientation": "horizontal",
          "drawer": {
                  "transition-duration": 500,
                  "children-class": "button1",
                  "transition-left-to-right": true,
                  "click-to-reveal": true
          },
          "modules": [
                  "custom/tyler",
                  "custom/terminal",
                  "group/hardware",
                  "group/launcher"

          ]
  },
  "custom/tyler":{
          "format":"󰣇",
          "tooltip":false
  },
  "custom/terminal":{
"format":"Terminal",
"tooltip":false,
"on-click":"xfce4-terminal"
  },
  "group/hardware": {
          "orientation": "horizontal",
          "drawer": {
                  "transition-duration": 500,
                  "children-class": "button1",
                  "transition-left-to-right": true,
                  "click-to-reveal": true
          },
          "modules": [
                  "custom/button",
                  "cpu",
                  "memory",
                  "gamemode"
          ]
  },
  "custom/button":{
          "format":"Performance",
          "tooltip":false
  },
  "cpu": {
          "format": "{usage}% ",
          "tooltip": true,
      "tooltip-format": "{icon0} {icon1} {icon2} {icon3} {icon4} {icon5} {icon6} {icon7}",
     "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },
  "memory": {
          "interval": 30,
          "format": "{used:0.1f}GB ",
          "tooltip":true,
          "tooltip-format":"Used:{used:0.1f}GB/Total:{total:0.1f}GB"
  },
  "gamemode": {
          "format": "{glyph}",
          "format-alt": "{glyph} {count}",
          "glyph": "",
          "hide-not-running": false,
          "use-icon": true,
          "icon-name": "input-gaming-symbolic",
          "icon-spacing": 4,
          "icon-size": 20,
          "tooltip": true,
          "tooltip-format": "Games running: {count}"
  },
  "group/launcher":{
          "format":"Launcher",
          "orientation": "horizontal",
          "drawer": {
                  "transition-duration": 500,
                  "children-class": "button1",
                  "transition-left-to-right": true,
                  "click-to-reveal": true
          },
          "modules": [
                  "custom/launcher"
          ]
  },
  "custom/launcher":{
"format":"Launcher",
"tooltip":false

  },


  "clock": {
          "timezone": "India/Kolkata",
          "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
          "format": "{:%a %b %d  %I:%M %p}"
  },

  "custom/swaync": {
          "format": "{}",
          "interval": 1,
          "exec": "~/.config/waybar/scripts/swaync_status.sh",
          "on-click": "~/.config/waybar/scripts/swaync_toggle.sh",
          "tooltip":false
  },

  "tray": {
          "icon-size": 15,
          "spacing": 13
  },
  "battery": {
          "format": "{icon}",
          "format-full": "{capacity}% {icon}",
          "format-alt": "<span>{capacity}% {icon} </span>",
          "format-icons": ["", "", "", "", ""]
  },
  "hyprland/workspaces": {    
          "disable-scroll": false,
          "all-outputs": true,
          "warp-on-scroll": true,
          "format": "{icon}",

          "format-icons": {
                  "focused":"󰲠",
                  "urgent": "",
                  "default": "",
                  "empty":"󰤂"
          },
          "persistent-workspaces":{
                  "*":5
          }
  },
  "pulseaudio": {
          "scroll-step": 1, 
        "format": "{volume}%  {icon}",
       "format-muted": "  Muted",
       "format-alt": "<span>{volume}% {icon} {format_source}</span>",
       "format-source": "{volume}% ",
       "format-source-muted": "",
       "format-icons": {
           "default": ["", "", ""]
       }

  },
"hyprland/window": {
  "format": "",             // hide the title entirely
  "icon": true,
  "icon-size": 20
}
}
