// -*- mode: jsonc -*-
{
   /* 
        !!!!!!!!!!!!!!!!!!!!
        !! Waybar_Configs !!
        !!!!!!!!!!!!!!!!!!!!
   */  
   "layer": "top",
   "position": "top",
   "spacing": 0,
   "height": 30,
   "margin-top": 2,
   "margin-right": 6,
   "margin-bottom": 0,
   "margin-left": 6,
   "padding":5,
   /*
        !!!!!!!!!!!!!!!
        !!! Modules !!!
        !!!!!!!!!!!!!!!
        */

        "modules-left": [

        ],
        "modules-center": [

        ],
        "modules-right": [
                "clock","tray","custom/swaync"

        ],

   /*
        !!!!!!!!!!!!!!!!!!!!!!!
        !!! Modules Configs !!!
        !!!!!!!!!!!!!!!!!!!!!!!
        */


        "clock": {
                "timezone": "India/Kolkata",
                "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
                "format": "{:%H:%M | %a, %d/%m/%y }"
        },
        "custom/swaync":{
                "tooltip": false,
                "format": "󱊖",
               /* "format-icons": {

                        "notification": "<span foreground='red'><sup></sup></span>",
                        "none": "",
                        "dnd-notification": "<span foreground='red'><sup></sup></span>",
                        "dnd-none": "",
                        "inhibited-notification": "<span foreground='red'><sup></sup></span>",
                        "inhibited-none": "",
                        "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
                        "dnd-inhibited-none": ""

                },*/
                "return-type": "json",
                "on-click": "swaync-client -t ",
                "on-click-right": "swaync-client -d ",
                "escape": true
        },

        "tray":{
                "icon-size": 12,
                "spacing": 10,
                "icons": {

                }
        }

}

